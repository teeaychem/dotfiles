# This is the configuration file for Ghostty.
#
# ghostty +show-config --default --docs
# https://ghostty.org/docs/config.

auto-update = off

cursor-style = block
drag-handle = never

font-family = "M+1Code Nerd Font Mono"

# Enable standard ligature/contextual font features.
font-feature = +liga
font-feature = +calt

font-size = 14

keybind = global:opt+super+space=toggle_quick_terminal
keybind = opt+shift+super+p=toggle_command_palette

keybind = super+0=reset_font_size
keybind = super++=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+==unbind
keybind = super+enter=unbind

# macOS owned
keybind = ctrl+tab=unbind
keybind = ctrl+shift+tab=unbind

macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden
macos-titlebar-style = native

mouse-hide-while-typing = true

shell-integration-features = no-cursor,sudo,title,ssh-env,ssh-terminfo,path

unfocused-split-opacity = 0.66

# Optional machine-local overrides; keep last.
config-file = ?config.local

# Set shell
#
# Homebrew on Apple Silicon:
# command = /opt/homebrew/bin/fish --login
#
# Nix, with Fish in active profile, e.g:
# command = /Users/YOUR_USER/.nix-profile/bin/fish --login
