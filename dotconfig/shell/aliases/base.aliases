# File search
fdd="fd --type d"
fdf="fd --type f"
fda="fd --no-ignore --hidden"
fde="fd --type f --extension"

# General tools
grep="grep --color=auto"
ll="ls -lh"
treea="tree -a --gitignore -I .git"

# Git
g="git"
gs="git status --short --branch"
gd="git diff"
gds="git diff --staged"
gl="git l"
gb="git branch"
gsw="git switch"
gwt="git worktree"

# Python
py="python3"
python="python3"
pyfind='find . -name "*.py"'
pygrep='rg -g "*.py" -g "!**/site-packages/"'

# C++
cxx20="clang++ -std=c++20 -Wall -Wextra"
cxx23="clang++ -std=c++23 -Wall -Wextra"
cxx20dbg="clang++ -std=c++20 -Wall -Wextra -g -O0"
cxx23dbg="clang++ -std=c++23 -Wall -Wextra -g -O0"
