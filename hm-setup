#!/usr/bin/env fish
# Run from the checkout root: ./hm-setup [--personal] [build|switch]
# build creates a generation without changing links; switch applies it (the default).
# --personal includes the optional personal/ configuration.

set -gx NIX_CONFIG "$NIX_CONFIG
extra-experimental-features = nix-command flakes"

set -l profile current
if test "$argv[1]" = --personal
    set profile current-personal
    set -e argv[1]
end

if not set -q argv[1]
    set argv switch
end

exec nix run .#home-manager -- $argv --flake ".#$profile" --impure
