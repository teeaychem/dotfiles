#!/usr/bin/env fish

# Download and install specified dictionaries.
#
# The upstream files are installed under their conventional en_GB, en_US, etc. names.
# The personal dictionary is left untouched.
set repository https://github.com/en-wl/wordlist

if not command -q hunspell
    echo 'Hunspell is not installed.' >&2; exit 1
end

if not set -q XDG_DATA_HOME; or test -z "$XDG_DATA_HOME"
    echo 'XDG_DATA_HOME is not set.' >&2; exit 1
end

set destination $XDG_DATA_HOME/hunspell
mkdir -p "$destination"; or exit

set latest_url (curl -fsSLo /dev/null -w '%{url_effective}\n' $repository/releases/latest); or exit

set tag (path basename $latest_url)
if not string match --quiet --regex '^rel-[0-9].*$' $tag
    echo "Failed to determine the latest dictionary release from $latest_url." >&2; exit 1
end

set dictionary_version (string replace rel- '' $tag)
set release_url $repository/releases/download/$tag

set temporary_directory (mktemp -d /tmp/install-hunspell.XXXXXXXX)
or exit

function install_dictionary --argument-names dictionary installed_name
    set archive hunspell-$dictionary-$dictionary_version.zip
    set extraction_directory $temporary_directory/$dictionary

    mkdir "$extraction_directory"; or exit

    echo "Downloading $dictionary $dictionary_version..."
    curl -fsSL $release_url/$archive -o $temporary_directory/$archive; or exit

    unzip -qt $temporary_directory/$archive >/dev/null; or exit

    unzip -q $temporary_directory/$archive -d "$extraction_directory"; or exit

    set affix_file $extraction_directory/$dictionary.aff
    set dictionary_file $extraction_directory/$dictionary.dic
    set readme_file $extraction_directory/README_$dictionary.txt

    for file in $affix_file $dictionary_file $readme_file
        if not test -s "$file"
            echo "The release archive is missing "(path basename $file)"." >&2; exit 1
        end
    end

    set expected_entries (sed -n '1p' $dictionary_file)
    set actual_entries (math (wc -l < $dictionary_file) - 1); or exit

    if not string match --quiet --regex '^[0-9]+$' $expected_entries
        echo "Invalid dictionary entry count: $expected_entries" >&2; exit 1
    end

    if test $actual_entries -ne $expected_entries
        echo "$dictionary contains $actual_entries entries; expected $expected_entries." >&2; exit 1
    end

    env DICPATH=$extraction_directory hunspell -d $dictionary -l </dev/null; or exit

    install -m 0644 $affix_file $destination/$installed_name.aff; or exit
    install -m 0644 $dictionary_file $destination/$installed_name.dic; or exit
    install -m 0644 $readme_file $destination/README_$dictionary.txt; or exit
end

install_dictionary en_GB-large en_GB
install_dictionary en_US-large en_US

echo "Installed dictionaries $dictionary_version in $destination"
