#!/usr/bin/env fish

set paths $argv
test (count $paths) -gt 0; or set paths .

if command -q fd
    fd -IH '(__pycache__|\.mypy_cache|\.pytest_cache)$' -t d $paths -x rm -rf --; or exit

    fd -IH '\.py[co]$' -t f $paths -x rm --; or exit
else
    find $paths \
        \( -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete \) -o \
        \( -type d \( -name __pycache__ -o -name '.mypy_cache' -o -name '.pytest_cache' \) -prune -exec rm -rf -- {} + \)
end
