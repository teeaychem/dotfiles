#!/usr/bin/env fish

# Environment:
#   CFLAGS  Optional compiler flags (default: Emacs configure defaults)
#
# Usage:
#   build-emacs [--install-dependencies] [--bootstrap]

function usage
    printf 'Usage: %s [--install-dependencies] [--bootstrap]\n' (status basename)
end

argparse \
    --max-args=0 \
    install-dependencies \
    bootstrap \
    h/help \
    -- $argv
or begin
    usage >&2
    exit 2
end

if set -q _flag_help
    usage
    exit
end

if not test -f configure.ac
    echo 'Run build-emacs from the root of an Emacs source tree.' >&2
    exit 1
end

set make_target
set -q _flag_bootstrap; and set make_target bootstrap

set prefix $HOME/.local
set jobs (getconf _NPROCESSORS_ONLN); or exit
set native_compilation aot # Alternatives: yes, no

if set -q _flag_install_dependencies
    switch (uname -s)
        case Darwin
            if not command -q brew
                echo 'Homebrew is required to install build dependencies.' >&2
                exit 1
            end

            brew install \
                autoconf \
                automake \
                gnutls \
                libgccjit \
                pkg-config \
                texinfo \
                tree-sitter
            or exit
        case Linux
            if not test -r /etc/os-release; or not grep -Eq '^ID="?ubuntu"?$' /etc/os-release
                echo 'Automatic dependency installation supports Ubuntu only.' >&2
                exit 1
            end

            set -gx PKG_CONFIG /usr/bin/pkg-config

            sudo apt-get update; or exit

            sudo apt-get install -y build-essential; or exit

            # Native compilation needs libgccjit for the default GCC version.
            set gcc_major (/usr/bin/gcc -dumpversion | string split .)[1]; or exit
            set libgccjit_dev libgccjit-$gcc_major-dev

            sudo apt-get install -y \
                autoconf \
                automake \
                $libgccjit_dev \
                libgnutls28-dev \
                libncurses-dev \
                libsqlite3-dev \
                libtree-sitter-dev \
                libxml2-dev \
                pkg-config \
                texinfo \
                zlib1g-dev
            or exit
        case '*'
            echo 'Unsupported operating system.' >&2
            exit 1
    end
end

./autogen.sh; or exit

# For a hybrid terminal/X build, replace --without-x with: --with-x --with-x-toolkit=lucid
./configure \
    --prefix=$prefix \
    --program-transform-name='s/^ctags$/ctags.emacs/' \
    --without-x \
    --without-ns \
    --without-pgtk \
    --without-dbus \
    --without-gsettings \
    --with-sound=no \
    --without-mailutils \
    --with-gnutls \
    --with-xml2 \
    --with-sqlite3 \
    --with-modules \
    --with-tree-sitter \
    --with-native-compilation=$native_compilation \
    --with-threads \
    --with-file-notification=yes \
    --without-compress-install
or exit

make $make_target -j$jobs; or exit

make install
